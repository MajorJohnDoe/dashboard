# Ignore node_modules directory
node_modules/
memory-bank/

# Ignore system files
.DS_Store

# Ignore log files
*.log
   
# Ignore config.php
config.php

# Ignore contents of user_upload and user_upload_temp directories, but not the directories themselves
user_upload/*
logs/*
!user_upload/.gitkeep
# The access rules for upload directories MUST be committed: without them a
# fresh deployment serves documents statically, bypassing the authenticated
# /attachment/download route.
!user_upload/.htaccess
user_upload_temp/*
!user_upload_temp/.gitkeep
!user_upload_temp/.htaccess
AGENTS.md

# Ignore skills
.github/
docs/
